# ============================================
# DermAI Environment Configuration
# ============================================

# ==================== API KEYS ====================
# Groq AI API Key (Required for chat functionality)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ==================== FLASK CONFIGURATION ====================
# Environment: development, production, testing
FLASK_ENV=development

# Debug mode: True for development, False for production
FLASK_DEBUG=True

# Secret key for session management (generate a random string for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ==================== DATABASE ====================
# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///instance/app.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/dermaidb

# ==================== SERVER CONFIGURATION ====================
# Backend server host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5002

# ==================== CORS CONFIGURATION ====================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5176,http://localhost:5173,http://localhost:3000

# ==================== FILE UPLOAD ====================
# Maximum file upload size (in bytes)
# 16MB = 16777216 bytes
MAX_UPLOAD_SIZE=16777216

# Allowed file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Upload folder path (relative to backend directory)
UPLOAD_FOLDER=static/uploads

# ==================== LOGGING ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# ==================== RATE LIMITING ====================
# Rate limit for API endpoints (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Rate limit for analysis endpoint (requests per hour)
ANALYSIS_RATE_LIMIT_PER_HOUR=20

# ==================== AI MODEL CONFIGURATION ====================
# Path to the AI model file (relative to project root)
MODEL_PATH=advanced_skin_disease_model.pth

# Device for model inference: cpu, cuda, mps (Apple Silicon)
DEVICE=cpu

# ==================== CACHE CONFIGURATION ====================
# Enable response caching
ENABLE_CACHE=True

# Cache timeout in seconds
CACHE_TIMEOUT=300

# ==================== PRODUCTION SETTINGS ====================
# (Uncomment and configure for production deployment)

# Database connection pool size
# DB_POOL_SIZE=10

# Enable SSL/HTTPS
# ENABLE_SSL=True

# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# Redis URL for caching and sessions
# REDIS_URL=redis://localhost:6379/0

# AWS S3 for file storage (optional)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your_bucket_name
# AWS_REGION=us-east-1

# ==================== MONITORING ====================
# Enable Prometheus metrics
# ENABLE_METRICS=True

# Enable health check endpoint
ENABLE_HEALTH_CHECK=True

# ==================== NOTES ====================
# 1. Never commit this file to version control with real credentials
# 2. Use .env.example as a template
# 3. Generate strong random values for SECRET_KEY in production
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. For production, use a secrets management service (AWS Secrets Manager, HashiCorp Vault, etc.)
